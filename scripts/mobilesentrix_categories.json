{
  "_comment": "MobileSentrix has no per-SKU URL like Injured Gadgets does (its genuine-parts pages list every product for a model on one page), so instead of one URL per product id, this maps each Pro Max model to its genuine-parts category page, plus a matcher per data.js product id (an include/exclude substring filter, matched case-insensitively against each product tile's name on that model's page) telling update_prices.py which tile on that page corresponds to which catalog id. preferExcluding substrings are only applied to break ties when more than one tile matches include/exclude (e.g. picking the US-version charging port over the Canadian/UK-EU one) - if applying them would eliminate every match, they're ignored rather than leaving nothing.",
  "categoryPages": [
    { "model": "12", "url": "https://www.mobilesentrix.com/replacement-parts/apple/genuine-apple-parts/iphones/iphone-12-pro-max" },
    { "model": "13", "url": "https://www.mobilesentrix.com/replacement-parts/apple/genuine-apple-parts/iphones/iphone-13-pro-max" },
    { "model": "14", "url": "https://www.mobilesentrix.com/replacement-parts/apple/genuine-apple-parts/iphones/iphone-14-pro-max" },
    { "model": "15", "url": "https://www.mobilesentrix.com/replacement-parts/apple/genuine-apple-parts/iphones/iphone-15-pro-max" },
    { "model": "16", "url": "https://www.mobilesentrix.com/replacement-parts/apple/genuine-apple-parts/iphones/iphone-16-pro-max" },
    { "model": "17", "url": "https://www.mobilesentrix.com/replacement-parts/apple/genuine-apple-parts/iphones/iphone-17-pro-max" }
  ],
  "matchers": [
